# ==============================================================================
# FlowDesk AI — Backend Environment Variables (Production & Staging Template)
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Frontend Client Origin (Allowed in CORS & Cookies)
# Set to your production Vercel domain (e.g., https://flowdesk-ai.vercel.app)
CLIENT_ORIGIN=https://your-frontend.vercel.app

# PostgreSQL Database Connection String
# Use Supabase connection pooling (port 5432 or 6543) with sslmode=require
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Authentication Config
# In production, generate strong 64-character random hex strings:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="generate-a-strong-64-character-hex-secret-for-access-tokens"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="generate-a-strong-64-character-hex-secret-for-refresh-tokens"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Demo Workspace ID (For development / fallback context)
DEMO_WORKSPACE_ID="00000000-0000-0000-0000-000000000001"
