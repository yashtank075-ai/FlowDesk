# ==============================================================================
# FlowDesk AI — Frontend Environment Variables (Production & Staging Template)
# ==============================================================================

# Backend API base URL (Vite exposes variables prefixed with VITE_ to the browser bundle)
# In production on Vercel, set this to your Render backend URL (e.g., https://flowdesk-api.onrender.com/api)
VITE_API_URL="https://your-backend-api.onrender.com/api"
